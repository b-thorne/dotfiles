{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# {{ include "Brewfile" | sha256sum }}  ← this line is the magic
# chezmoi re-runs this script whenever the Brewfile content changes

set -e

brew_bin=$(command -v brew 2>/dev/null || true)
if [ -z "$brew_bin" ]; then
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$candidate" ]; then
      brew_bin=$candidate
      break
    fi
  done
fi
if [ -z "$brew_bin" ]; then
  echo "Homebrew is not installed" >&2
  exit 1
fi

# Homebrew 6 requires explicit trust before loading third-party code.
if "$brew_bin" trust --help >/dev/null 2>&1; then
  "$brew_bin" trust --formula hashicorp/tap/nomad
  "$brew_bin" trust --formula federico-terzi/espanso/espanso
  "$brew_bin" trust --cask epk/epk/font-sf-mono-nerd-font
fi

echo "Running brew bundle..."
"$brew_bin" bundle --file="{{ .chezmoi.sourceDir }}/Brewfile"
{{ end -}}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bthorne.nomad-mount</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/bthorne/.local/bin/ensure-nomad-mount</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/bthorne</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/bthorne/Library/Logs/nomad-mount.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bthorne/Library/Logs/nomad-mount.error.log</string>
</dict>
</plist>

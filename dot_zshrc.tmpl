# Make a Homebrew installation available in fresh shells.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Secrets are kept outside this public repository.
[ -f "$HOME/.zsh_secrets" ] && source "$HOME/.zsh_secrets"

# Aliases
alias ls='ls -l'
alias cat='bat'

# AWS CLI setup
export AWS_PROFILE=dev

path=("$HOME/.juliaup/bin" $path)
export PATH

# ----- Pi toggle -----
# Use iTerm2's pink Pi profile only while the Pi process is in front.
_iterm_set_profile() {
  [[ "$TERM_PROGRAM" == "iTerm.app" ]] || return 0
  printf '\e]1337;SetProfile=%s\a' "$1" > /dev/tty
}

# Wrap normal `pi` launches, restoring the shell profile after exit/suspend.
pi() {
  _iterm_set_profile Pi
  command pi "$@"
  local status=$?
  _iterm_set_profile Default
  return $status
}

# iTerm2 maps Cmd+Shift+P to one Ctrl-Z byte. Pi suspends on Ctrl-Z;
# at the shell, the same byte resumes a stopped Pi job or launches Pi.
_pi_toggle_widget() {
  zle -I
  if jobs %pi >/dev/null 2>&1; then
    _iterm_set_profile Pi
    fg %pi
    _iterm_set_profile Default
  else
    pi </dev/tty >/dev/tty 2>/dev/tty
  fi
  return 0
}
zle -N _pi_toggle_widget
bindkey '^Z' _pi_toggle_widget

source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

eval "$(starship init zsh)"

export PATH="$HOME/.opencode/bin:$PATH"
